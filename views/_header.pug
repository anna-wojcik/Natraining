header.header  
  nav.nav
    a.nav__el-logo(href='/')
      img.nav__logo-img(src=`/img/sportCenter-logo.png` alt='Logo') 
      span SportCenter
  nav.nav 
    if user 
      a.nav__el.nav__el--logout Log out 
      a.nav__user(href='/me')
        img.nav__user-img(src=`/img/users/${user.photo}` alt=`Photo of ${user.name}`)
        span= user.name.split(' ')[0]
    else 
      a.nav__el.nav__el--login(href='/login') Log in 
      //- a.nav__el.nav__el--signup(href='/signup') Sign up
